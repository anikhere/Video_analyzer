# Only ONE LLM key is required! YT_KEY is now optional (falls back to zero-key oEmbed).
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openrouter/free

# Optional: add YT_KEY only if you want YouTube Data API v3 view/like/comment counts.
# YT_KEY=your_youtube_data_api_key

# Optional alternative: set LLM_PROVIDER=gemini and configure these instead.
# Create a key at https://aistudio.google.com/apikey — both AIza... and AQ....
# keys work with the default AI Studio endpoint (no extra config needed).
# GEMINI_API_KEY=your_google_ai_studio_key
# GEMINI_MODEL=gemini-2.5-flash

# Vertex AI Express keys (AQ.... issued for Vertex) only: uncomment to route
# Gemini calls to aiplatform.googleapis.com instead of the AI Studio endpoint.
# Leave commented for normal AI Studio keys — the app auto-retries on the
# other surface if Google returns 403 PERMISSION_DENIED.
# GOOGLE_GENAI_USE_VERTEXAI=true

# --- Gemini 403 troubleshooting (PERMISSION_DENIED) ---
# 1. Use a fresh key from https://aistudio.google.com/apikey (no spaces/quotes).
# 2. Enable "Generative Language API" for the key's Google Cloud project:
#    Cloud Console -> APIs & Services -> Library -> Generative Language API -> Enable.
# 3. Check API restrictions: Cloud Console -> APIs & Services -> Credentials ->
#    your key -> restrict to "Generative Language API" (or "Vertex AI API" for
#    Vertex Express keys).
# 4. Confirm the model is available to your key/region (try gemini-2.5-flash-lite).
