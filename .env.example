# Only ONE LLM key is required! YT_KEY is now optional (falls back to zero-key oEmbed).
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openrouter/free

# Optional: add YT_KEY only if you want YouTube Data API v3 view/like/comment counts.
# YT_KEY=your_youtube_data_api_key

# Optional alternative: set LLM_PROVIDER=gemini and configure these instead.
# GEMINI_API_KEY=your_google_ai_studio_key
# GEMINI_MODEL=gemini-2.5-flash
